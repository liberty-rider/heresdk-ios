{
  "$schema": "AutomotiveCameraConfiguration.schema.json",
  "camera": {
    "maxZoomLevel": 20.0,
    "animationDurationMs": 500,
    "principalPointAnimationDurationMs": 500,
    "recenterAnimationDurationMs": 500,
    "maxRotationSpeedDegreesPerSecond": 20.0,
    "zoomSpeedLevelsPerSecond": 0.5
  },
  "roadParameters": {
    "default": {
      "zoom": 16.5
    },
    "roadClassMap": [
      {
        "roadClass": "class1",
        "trackingParameters": {
          "zoom": 16
        }
      },
      {
        "roadClass": "class2",
        "trackingParameters": {
          "zoom": 16.5
        }
      },
      {
        "roadClass": "class3",
        "trackingParameters": {
          "zoom": 17
        }
      },
      {
        "roadClass": "class4",
        "trackingParameters": {
          "zoom": 17
        }
      },
      {
        "roadClass": "class5",
        "trackingParameters": {
          "zoom": 17.5
        }
      }
    ],
    "speedClassMap": {
      "delayBetweenThresholdChanges": 10,
      "slowSpeed": {
        "thresholds": [
          { "speed": 0, "zoomLevel": 18 },
          { "speed": 30, "zoomLevel": 17 },
          { "speed": 90, "zoomLevel": 16 }
        ]
      },
      "regularSpeed": {
        "thresholds": [
          { "speed": 0, "zoomLevel": 18 },
          { "speed": 30, "zoomLevel": 17 },
          { "speed": 90, "zoomLevel": 16 },
          { "speed": 150, "zoomLevel": 15 }
        ]
      },
      "fastSpeed": {
        "thresholds": [
          { "speed": 0, "zoomLevel": 17 },
          { "speed": 60, "zoomLevel": 16 },
          { "speed": 120, "zoomLevel": 15 },
          { "speed": 180, "zoomLevel": 14 }
        ]
      }
    }
  },
  "modes": {
    "2D": {
      "tiltDegrees": 0.0,
      "principalPoint": {
        "y": 0.75
      }
    },
    "3D": {
      "tiltDegrees": 45.0,
      "principalPoint": {
        "y": 0.75
      }
    },
    "northUp": {
      "tiltDegrees": 0.0,
      "bearingDegrees": 0.0,
      "principalPoint": {
        "y": 0.5
      }
    }
  },
  "maneuverDetection": {
    "enabled": true,
    "bearingThresholdDegrees": 25.0,
    "rules": [
      {
        "roadClasses": ["class1", "class2"],
        "actions": ["turnLeft", "turnRight"],
        "options": {
          "maxZoom": 19.0,
          "earlyPreActivationMeters": 600.0,
          "preActivationMeters": 300.0,
          "postActivationMeters": 100.0
        }
      },
      {
        "roadClasses": [],
        "actions": ["arrive"],
        "options": {
          "maxZoom": 19.0,
          "preActivationMeters": 200.0,
          "postActivationMeters": 50.0
        }
      }
    ]
  }
}
