{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "AutomotiveCameraConfiguration.schema.json",
  "title": "AutomotiveCameraConfiguration",
  "description": "Configuration schema for automotive navigation camera. Defines camera behavior, zoom policies based on road and speed, display modes, and maneuver detection.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema file for IDE validation."
    },
    "camera": {
      "$ref": "#/definitions/CameraSettings"
    },
    "roadParameters": {
      "$ref": "#/definitions/RoadParameters"
    },
    "modes": {
      "$ref": "#/definitions/ModesConfig"
    },
    "maneuverDetection": {
      "$ref": "#/definitions/ManeuverDetectionConfig"
    }
  },
  "definitions": {
    "CameraSettings": {
      "type": "object",
      "description": "Global camera behavior settings.",
      "additionalProperties": false,
      "properties": {
        "maxZoomLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 22,
          "default": 20.0,
          "description": "Maximum allowed zoom level."
        },
        "animationDurationMs": {
          "type": "integer",
          "minimum": 0,
          "default": 500,
          "description": "Duration of camera animations in milliseconds."
        },
        "principalPointAnimationDurationMs": {
          "type": "integer",
          "minimum": 0,
          "default": 500,
          "description": "Duration of principal point animation in milliseconds."
        },
        "recenterAnimationDurationMs": {
          "type": "integer",
          "minimum": 0,
          "default": 500,
          "description": "Duration of recenter animation in milliseconds."
        },
        "maxRotationSpeedDegreesPerSecond": {
          "type": "number",
          "minimum": 0,
          "default": 20.0,
          "description": "Maximum bearing rotation speed in degrees per second."
        },
        "zoomSpeedLevelsPerSecond": {
          "type": "number",
          "minimum": 0,
          "default": 0.5,
          "description": "Speed of zoom level transitions per second."
        }
      }
    },
    "RoadParameters": {
      "type": "object",
      "description": "Road-based zoom parameters. If zoomPolicy is set, uses that policy. Otherwise: speedClassMap > roadClassMap > default speedBased.",
      "additionalProperties": false,
      "properties": {
        "zoomPolicy": {
          "type": "string",
          "enum": ["fixed", "speedBased", "roadClass"],
          "description": "Optional. Explicitly sets the zoom policy, overriding auto-detection."
        },
        "default": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "zoom": {
              "type": "number",
              "minimum": 0,
              "maximum": 22,
              "default": 17.0,
              "description": "Default zoom level when no specific road class match."
            }
          }
        },
        "roadClassMap": {
          "type": "array",
          "description": "Zoom level mappings for functional road classes. Used only when speedClassMap is not present.",
          "items": {
            "$ref": "#/definitions/RoadClassMapping"
          }
        },
        "speedClassMap": {
          "$ref": "#/definitions/SpeedClassMap"
        }
      }
    },
    "RoadClassMapping": {
      "type": "object",
      "description": "Mapping of a functional road class to zoom parameters.",
      "additionalProperties": false,
      "properties": {
        "roadClass": {
          "type": "string",
          "enum": ["class1", "class2", "class3", "class4", "class5"],
          "description": "Functional road class (class1 = highest priority highway, class5 = local roads)."
        },
        "trackingParameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "zoom": {
              "type": "number",
              "minimum": 0,
              "maximum": 22,
              "description": "Zoom level for this road class."
            }
          }
        }
      },
      "required": ["roadClass", "trackingParameters"]
    },
    "SpeedClassMap": {
      "type": "object",
      "description": "Speed-based zoom configuration. Takes priority over roadClassMap.",
      "additionalProperties": false,
      "properties": {
        "delayBetweenThresholdChanges": {
          "type": "integer",
          "minimum": 0,
          "description": "Delay between consecutive zoom changes in seconds."
        },
        "slowSpeed": {
          "$ref": "#/definitions/SpeedClassThresholds"
        },
        "regularSpeed": {
          "$ref": "#/definitions/SpeedClassThresholds"
        },
        "fastSpeed": {
          "$ref": "#/definitions/SpeedClassThresholds"
        }
      }
    },
    "SpeedClassThresholds": {
      "type": "object",
      "description": "Speed thresholds for a timing profile.",
      "additionalProperties": false,
      "properties": {
        "thresholds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SpeedThreshold"
          },
          "description": "Array of speed-to-zoom thresholds."
        }
      }
    },
    "SpeedThreshold": {
      "type": "object",
      "description": "A speed-to-zoom mapping threshold.",
      "additionalProperties": false,
      "properties": {
        "speed": {
          "type": "number",
          "minimum": 0,
          "description": "Speed threshold (unit depends on configuration)."
        },
        "zoomLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 22,
          "description": "Zoom level to use at or above this speed."
        }
      }
    },
    "ModesConfig": {
      "type": "object",
      "description": "Camera settings for each display mode.",
      "additionalProperties": false,
      "properties": {
        "2D": {
          "$ref": "#/definitions/ModeOptions"
        },
        "3D": {
          "$ref": "#/definitions/ModeOptions"
        },
        "northUp": {
          "$ref": "#/definitions/ModeOptions"
        }
      }
    },
    "ModeOptions": {
      "type": "object",
      "description": "Camera settings for a specific display mode.",
      "additionalProperties": false,
      "properties": {
        "tiltDegrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 90,
          "default": 0.0,
          "description": "Camera tilt angle in degrees."
        },
        "bearingDegrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "description": "Fixed camera bearing in degrees. When null/omitted, bearing follows vehicle heading."
        },
        "principalPoint": {
          "$ref": "#/definitions/PrincipalPoint"
        }
      }
    },
    "PrincipalPoint": {
      "type": "object",
      "description": "Normalized principal point for camera positioning. Horizontal is always centered (0.5).",
      "additionalProperties": false,
      "properties": {
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.75,
          "description": "Vertical position (0.0 = top, 1.0 = bottom). Defaults to 0.75."
        }
      }
    },
    "ManeuverDetectionConfig": {
      "type": "object",
      "description": "Configuration for maneuver detection behavior.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether maneuver detection is enabled."
        },
        "bearingThresholdDegrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 180,
          "description": "Bearing change threshold in degrees to trigger maneuver mode."
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ManeuverRule"
          },
          "description": "List of maneuver rules defining behavior for specific situations."
        }
      }
    },
    "ManeuverRule": {
      "type": "object",
      "description": "A rule defining camera behavior for specific maneuver situations.",
      "additionalProperties": false,
      "properties": {
        "roadClasses": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["class1", "class2", "class3", "class4", "class5"]
          },
          "description": "Functional road classes this rule applies to. Empty array means all classes."
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["continue", "arrive", "turnLeft", "turnRight"]
          },
          "description": "Maneuver actions this rule applies to. Empty array means all actions."
        },
        "options": {
          "$ref": "#/definitions/ManeuverRuleOptions"
        }
      }
    },
    "ManeuverRuleOptions": {
      "type": "object",
      "description": "Options for a maneuver rule.",
      "additionalProperties": false,
      "properties": {
        "maxZoom": {
          "type": "number",
          "minimum": 0,
          "maximum": 22,
          "description": "Maximum zoom level during maneuver."
        },
        "earlyPreActivationMeters": {
          "type": "number",
          "minimum": 0,
          "description": "Distance in meters for early pre-maneuver activation."
        },
        "preActivationMeters": {
          "type": "number",
          "minimum": 0,
          "description": "Distance in meters before maneuver to activate."
        },
        "postActivationMeters": {
          "type": "number",
          "minimum": 0,
          "description": "Distance in meters after maneuver to remain active."
        }
      }
    }
  }
}
